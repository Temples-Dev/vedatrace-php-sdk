{
    "name": "vedatrace/vedatrace-php",
    "description": "VedaTrace SDK for PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "VedaTrace Team",
            "email": "support@vedatrace.dev"
        }
    ],
    "require": {
        "php": ">=8.1",
        "psr/log": "^3.0",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/container": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/config": "^10.0|^11.0|^12.0|^13.0",
        "phpoption/phpoption": "^1.9",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "VedaTrace\\": "src/"
        },
        "files": [
            "src/VedaTrace.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "VedaTrace\\Tests\\": "tests/"
        }
  }
}
